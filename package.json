{
  "name": "fluxgantt-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "FluxGantt documentation + landing site (Vocs), deployed to https://fluxgantt.thai-pc.com. Not published to npm.",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vocs dev",
    "build": "vocs build && node scripts/finalize-pages-build.mjs",
    "preview": "vocs preview",
    "typecheck": "tsc --noEmit",
    "check:imports": "node scripts/check-snippet-imports.mjs",
    "check": "npm run typecheck && npm run check:imports"
  },
  "dependencies": {
    "@fluxgantt/core": "0.9.0",
    "@fluxgantt/react": "0.5.1",
    "@fluxgantt/vue": "0.5.1"
  },
  "devDependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@types/react": "^19.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^6.0.3",
    "vocs": "^2.10.0",
    "vue": "^3.4.0",
    "waku": "1.0.0-rc.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thai-pc/fluxgantt-docs.git"
  },
  "homepage": "https://fluxgantt.thai-pc.com"
}
